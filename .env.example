# Plantilla del entorno. Cópiala a `.env` y rellena los valores.
#
#   cp .env.example .env
#
# ⚠️ `.env` NUNCA se sube al repositorio (está en .gitignore). El del servidor
# se escribe a mano allí, una sola vez.

# Base de datos SQLite. La ruta es relativa a prisma/.
DATABASE_URL="file:./dev.db"

# Firma las sesiones de NextAuth.
#
# ⚠️ EN EL SERVIDOR TIENE QUE SER OTRO, generado ahí y distinto del de
# desarrollo. Si se reutiliza el de local, cualquiera con ese valor puede
# fabricarse una cookie de sesión válida en producción.
#
#   openssl rand -base64 32
AUTH_SECRET="pon-aqui-un-valor-generado"

# No hace falta fijarla: con `trustHost: true` NextAuth usa el host real de cada
# petición, así funciona igual por el dominio, por la IP o desde el celular.
# NEXTAUTH_URL="https://www.conectaia.solucionesctec.com"
